{
  "manifest_version": 3,
  "name": "Yoke",
  "version": "0.1.4",
  "description": "Let MCP clients drive your signed in Chrome by tab id: tabs, page text, trusted input, screenshots, console, network.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Yoke",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "tabGroups",
    "nativeMessaging",
    "scripting",
    "debugger"
  ],
  "background": {
    "service_worker": "browser/background.js",
    "type": "module"
  },
  "host_permissions": [
    "<all_urls>"
  ]
}
