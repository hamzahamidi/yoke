{
  "name": "yoke-mcp",
  "version": "0.1.4",
  "description": "MCP server for the Chrome you are already signed in to. Every tab in every window, addressed by tab id, with no second profile and no browser-wide debugging port.",
  "bin": {
    "yoke": "dist/cli.js"
  },
  "files": [
    "dist/",
    "!dist/*.sh",
    "!dist/*.bat",
    "!dist/store/",
    "extension/",
    "LICENSE",
    "README.md",
    "ROADMAP.md",
    "MOTIVATION.md",
    "PRIVACY.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.extension.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.extension.json --noEmit",
    "test": "npm run build && node --test --experimental-strip-types test/*.test.ts",
    "lint": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "check:versions": "node scripts/check-versions.mjs",
    "prepublishOnly": "npm run clean && npm run build && npm run check:versions",
    "package": "npm run build && node scripts/package-extension.mjs",
    "screenshot": "node scripts/render-screenshot.mjs"
  },
  "keywords": [
    "mcp",
    "chrome",
    "browser-automation",
    "extension",
    "tab-groups"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamzahamidi/yoke.git"
  },
  "main": "dist/mcp-server.js",
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "type": "module",
  "homepage": "https://github.com/hamzahamidi/yoke#readme",
  "bugs": {
    "url": "https://github.com/hamzahamidi/yoke/issues"
  }
}
